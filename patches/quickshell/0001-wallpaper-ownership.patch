diff --git a/src/windows/system/wallpaper_write_policy.hpp b/src/windows/system/wallpaper_write_policy.hpp
new file mode 100644
index 0000000..6db4c06
--- /dev/null
+++ b/src/windows/system/wallpaper_write_policy.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace qs::windows::sys {
+
+class WallpaperWritePolicy {
+public:
+	using Token = std::uint64_t;
+
+	[[nodiscard]] Token token() const { return this->state.load(std::memory_order_acquire); }
+	[[nodiscard]] bool external() const { return (this->token() & 1) != 0; }
+	[[nodiscard]] bool allows(Token token) const { return (token & 1) == 0 && this->token() == token; }
+
+	bool setExternal(bool external) {
+		auto previous = this->token();
+		while (true) {
+			if (((previous & 1) != 0) == external) return false;
+			auto next = ((previous & ~Token(1)) + 2) | Token(external);
+			if (this->state.compare_exchange_weak(
+			        previous, next, std::memory_order_acq_rel, std::memory_order_acquire
+			    )) return true;
+		}
+	}
+
+private:
+	std::atomic<Token> state = 0;
+};
+
+} // namespace qs::windows::sys
